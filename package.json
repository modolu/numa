{
  "name": "numa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:convex": "convex dev",
    "build": "NEXT_PUBLIC_CONVEX_URL=${VITE_CONVEX_URL:-$NEXT_PUBLIC_CONVEX_URL} next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "deploy": "npx @convex-dev/static-hosting deploy -d out",
    "deploy:site": "npx @convex-dev/static-hosting upload --build --prod -d out"
  },
  "dependencies": {
    "@convex-dev/static-hosting": "^0.2.1",
    "@mendable/firecrawl-js": "^4.41.0",
    "agentmail": "^0.5.27",
    "convex": "^1.46.0",
    "next": "16.3.5",
    "openai": "^7.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.59",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
