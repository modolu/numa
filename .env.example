# Written by `npx convex dev` into .env.local (never commit .env.local).
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Server-side only. Set these as Convex deployment env vars when each
# integration milestone begins. Never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Firecrawl scrape key for official-source monitoring (Convex env var):
#   npx convex env set FIRECRAWL_API_KEY <key>
FIRECRAWL_API_KEY=
AGENTMAIL_API_KEY=

# Optional Ethereum JSON-RPC endpoint for wallet scans (Convex env var).
# Defaults to a public RPC when unset.
ONCHAIN_PROVIDER_URL=
ONCHAIN_PROVIDER_KEY=

ARC_MODE=ADVISORY
