# Written by `npx convex dev` into .env.local (never commit .env.local).
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Server-side only. Set these as Convex deployment env vars when each
# integration milestone begins. Never prefix secrets with NEXT_PUBLIC_.
# OpenAI Responses API key for source interpretation (Convex env var):
#   npx convex env set OPENAI_API_KEY <key>      optional: OPENAI_MODEL=gpt-5-mini
OPENAI_API_KEY=
# Firecrawl scrape key for official-source monitoring (Convex env var):
#   npx convex env set FIRECRAWL_API_KEY <key>
FIRECRAWL_API_KEY=
# AgentMail outbound email (Convex env vars). The key needs message_send;
# AGENTMAIL_INBOX_ID is the sending inbox address; NUMA_DEV_RECIPIENT_EMAIL is
# the development recipient until real auth exists. Never commit real values.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
NUMA_DEV_RECIPIENT_EMAIL=
AGENTMAIL_WEBHOOK_SECRET=
NUMA_APP_URL=

# Optional Ethereum JSON-RPC endpoint for wallet scans (Convex env var).
# Defaults to a public RPC when unset.
ONCHAIN_PROVIDER_URL=
ONCHAIN_PROVIDER_KEY=

ARC_MODE=ADVISORY
